{
  "name": "concert-compass-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "bun run build && concurrently -k \"vite --host 127.0.0.1 --strictPort\" \"wait-on http://127.0.0.1:5173 && cross-env COMPASS_DEV=1 electron .\"",
    "prepare:audio-model": "node tools/prepare-audio-model.mjs",
    "build": "node tools/prepare-audio-model.mjs && vite build && tsc -p tsconfig.electron.json && esbuild electron/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/electron/preload.cjs",
    "start": "electron .",
    "package:win": "node tools/package.mjs",
    "test": "tsx --test --test-concurrency=1 tests/**/*.test.ts"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@electron/packager": "^18.4.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "cross-env": "^7.0.3",
    "esbuild": "^0.27.0",
    "electron": "32.3.3",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.0.0",
    "wait-on": "^9.0.0"
  }
}
